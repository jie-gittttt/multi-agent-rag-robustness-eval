# =========================================
# RAG 鲁棒性评估工具 — 环境变量配置模板
# 复制为 .env 后填入你的 API Key
# =========================================

# LLM 服务商: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 或用 DeepSeek（兼容 OpenAI API）：
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-pro

# 或用 Anthropic：
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# 嵌入服务商: openai | local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索参数
RETRIEVAL_TOP_K=5

# RAGFlow（第三方开源 RAG 系统）
# 示例: http://127.0.0.1:9380
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
# RAGFlow 中已创建的数据集/知识库 ID
RAGFLOW_KB_ID=

# 数据目录（仅在接入水泥 LCA RAG 时需要）
# DATA_DIR=/path/to/rag/backend/data
